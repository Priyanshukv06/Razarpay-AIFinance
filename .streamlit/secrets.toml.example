# .streamlit/secrets.toml -- Streamlit Cloud Secrets Template
#
# On Streamlit Cloud, paste this into Settings → Secrets.
# Locally, place this file at .streamlit/secrets.toml (git-ignored).
# These are injected as environment variables automatically.

# LLM Providers (comma-separated for multiple keys)
GROQ_API_KEYS = ""
GEMINI_API_KEYS = ""
OPENROUTER_API_KEYS = ""
MISTRAL_API_KEYS = ""
NVIDIA_API_KEYS = ""

# Supabase (optional -- caching disabled if absent)
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""
