# ===========================================================================
# AI Finance Controller — API Keys
# ===========================================================================
# Copy this file to `.env` (same folder) and paste your keys in.
#   Copy-Item .env.example .env
#
# `.env` is git-ignored; this template is not, so NEVER put a real key here.
#
# FORMAT: every variable takes a COMMA-SEPARATED list for multiple keys:
#     GROQ_API_KEYS=key1,key2,key3
# Leave a provider blank or delete the line to disable it — the router skips
# any provider with no key rather than erroring.
#
# WHY MULTIPLE KEYS: keys from SEPARATE accounts give separate quota. The
# router round-robins across keys (spreading load) and rotates on failure
# (failover). Both are no-ops with a single key.
# ===========================================================================

# Groq — fastest inference (LPU hardware). Primary provider.
# Get it: https://console.groq.com/keys (no card needed)
# Free tier: ~30 req/min, ~14,400/day
GROQ_API_KEYS=

# Google Gemini — best free-tier daily volume (500 req/day on Flash)
# Get it: https://aistudio.google.com/apikey (Google account, no card)
GEMINI_API_KEYS=

# OpenRouter — one key, many free models (`:free` suffix)
# Get it: https://openrouter.ai/keys (no card needed)
# ~20 RPM, ~50-1000 req/day depending on account age
OPENROUTER_API_KEYS=

# Mistral — "Experiment" free tier, ~1B tokens/month
# Get it: https://console.mistral.ai/api-keys
MISTRAL_API_KEYS=

# NVIDIA NIM — credit-based, 1000 free credits on signup
# Get it: https://build.nvidia.com (sign in → "Get API Key")
NVIDIA_API_KEYS=

# ===========================================================================
# Supabase — result caching + Q&A history (optional)
# ===========================================================================
# Get it: https://supabase.com → New Project → Settings → API
# Free tier: 500 MB storage, unlimited API calls
# If not set, caching is disabled (app still works, just no persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
